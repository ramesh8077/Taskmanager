# ============================================
# Team Task Manager - Environment Variables
# ============================================

# Server Configuration
PORT=5000
NODE_ENV=development
# Optional persistent directory outside the web root for ticket attachments
TICKET_ATTACHMENT_DIR=storage/ticket-attachments

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=team_task_manager
DB_USER=root
DB_PASSWORD=

# Generate a random secret of at least 32 characters. Never use an example value.
JWT_SECRET=f763349f5ee1fae15dfecc077452b1cf5d3e11196b863c64a00f3bda70cbc0ce
JWT_EXPIRES_IN=7d

# Exact frontend origins, comma-separated (do not use "*")
CORS_ORIGIN=http://localhost:3000

# Optional: promote an existing account to SUPER_ADMIN when running db:seed
SUPER_ADMIN_EMAIL=
MANAGER_ENABLED=false
