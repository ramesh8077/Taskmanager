{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["src/**/*.js", "shared/**/*.js"]
      }
    },
    {
      "src": "api/realtime.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["src/**/*.js", "shared/**/*.js"]
      }
    }
  ],
  "routes": [
    {
      "src": "^/api/realtime/notifications$",
      "dest": "/api/realtime.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
